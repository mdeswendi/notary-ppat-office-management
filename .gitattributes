# Notary & PPAT Office Management System
#
# Normalize all text to LF in the repository. Working-tree endings are left to the
# platform and to .editorconfig.

* text=auto eol=lf

# ---------- Documentation ----------
*.md        text eol=lf
*.mdx       text eol=lf
*.txt       text eol=lf

# ---------- Frontend source ----------
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf

# ---------- Backend source ----------
*.php       text eol=lf
*.blade.php text eol=lf

# ---------- Data and configuration ----------
*.json      text eol=lf
*.jsonc     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.sql       text eol=lf
*.env.example text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore  text eol=lf
Dockerfile  text eol=lf

# ---------- Shell ----------
*.sh        text eol=lf
*.bash      text eol=lf

# Windows scripts keep CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ---------- Binary assets ----------
# Application source code is never marked binary.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
